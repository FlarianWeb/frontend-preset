{
	"name": "@flarian/frontend-preset",
	"version": "2.0.5",
	"license": "MIT",
	"description": "Frontend preset: ESLint 10 flat config, Prettier and Stylelint in one package",
	"author": "FlarianWeb",
	"keywords": [
		"eslint",
		"stylelint",
		"vue",
		"frontend",
		"preset",
		"linting"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./eslint": {
			"import": {
				"types": "./dist/eslint/index.d.mts",
				"default": "./dist/eslint/index.mjs"
			},
			"require": {
				"types": "./dist/eslint/index.d.cts",
				"default": "./dist/eslint/index.cjs"
			}
		},
		"./eslint/*": {
			"import": {
				"types": "./dist/eslint/config/*.d.mts",
				"default": "./dist/eslint/config/*.mjs"
			},
			"require": {
				"types": "./dist/eslint/config/*.d.cts",
				"default": "./dist/eslint/config/*.cjs"
			}
		},
		"./prettier": {
			"import": {
				"types": "./dist/prettier/index.d.mts",
				"default": "./dist/prettier/index.mjs"
			},
			"require": {
				"types": "./dist/prettier/index.d.cts",
				"default": "./dist/prettier/index.cjs"
			}
		},
		"./prettier/*": {
			"import": {
				"types": "./dist/prettier/config/*.d.mts",
				"default": "./dist/prettier/config/*.mjs"
			},
			"require": {
				"types": "./dist/prettier/config/*.d.cts",
				"default": "./dist/prettier/config/*.cjs"
			}
		},
		"./stylelint": {
			"import": {
				"types": "./dist/stylelint/index.d.mts",
				"default": "./dist/stylelint/index.mjs"
			},
			"require": {
				"types": "./dist/stylelint/index.d.cts",
				"default": "./dist/stylelint/index.cjs"
			}
		},
		"./stylelint/*": {
			"import": {
				"types": "./dist/stylelint/config/*.d.mts",
				"default": "./dist/stylelint/config/*.mjs"
			},
			"require": {
				"types": "./dist/stylelint/config/*.d.cts",
				"default": "./dist/stylelint/config/*.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "NODE_OPTIONS=\"--max-old-space-size=4096\" unbuild",
		"inspect": "eslint --inspect-config",
		"lint": "eslint",
		"typecheck": "tsc --noEmit",
		"check:deprecated": "node scripts/check-deprecated.mjs",
		"pack:local": "pnpm build && pnpm pack"
	},
	"engines": {
		"node": ">=22.5.0"
	},
	"packageManager": "pnpm@10.33.2",
	"dependencies": {
		"@eslint/js": "^10.0.1",
		"@prettier/plugin-pug": "^3.4.2",
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsonc": "^3.4.1",
		"eslint-plugin-perfectionist": "^5.10.1",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-vue": "^10.10.0",
		"globals": "^17.11.0",
		"postcss-html": "^1.8.0",
		"stylelint-config-recommended-vue": "^1.6.1",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-config-standard-less": "^4.1.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-less": "^4.2.1",
		"stylelint-order": "^8.1.1",
		"stylelint-scss": "^7.2.0",
		"typescript-eslint": "^8.67.0",
		"vue-eslint-parser": "^10.4.1"
	},
	"devDependencies": {
		"@semantic-release/changelog": "6.0.3",
		"@semantic-release/git": "10.0.1",
		"@semantic-release/github": "12.0.6",
		"@semantic-release/npm": "13.1.5",
		"@types/eslint": "9.6.1",
		"@types/node": "25.6.0",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"eslint": "10.8.1",
		"prettier": "3.8.3",
		"semantic-release": "25.0.3",
		"stylelint": "17.14.1",
		"typescript": "6.0.3",
		"unbuild": "3.6.1"
	},
	"peerDependencies": {
		"eslint": ">=10.0.0",
		"prettier": ">=3.6.0",
		"stylelint": ">=17.0.0"
	},
	"pnpm": {
		"overrides": {
			"handlebars": "^4.7.9",
			"eslint-plugin-react>minimatch": "^3.1.3",
			"rollup": "^4.59.0",
			"@actions/http-client>undici": "^6.24.0",
			"@semantic-release/github>undici": "^7.24.0",
			"unbuild>defu": "^6.1.5",
			"flatted": "^3.4.2",
			"micromatch>picomatch": "^2.3.2",
			"tinyglobby>picomatch": "^4.0.4",
			"@stylistic/eslint-plugin>picomatch": "^4.0.4",
			"postcss": "^8.5.10",
			"svgo": "^4.0.1"
		}
	},
	"peerDependenciesMeta": {
		"prettier": {
			"optional": true
		},
		"stylelint": {
			"optional": true
		}
	}
}
