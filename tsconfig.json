{
	"compilerOptions": {
		"declaration": true,
		"emitDeclarationOnly": false,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"rootDir": "./src",
		"skipLibCheck": true,
		"strict": true,
		"outDir": "./dist"
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
